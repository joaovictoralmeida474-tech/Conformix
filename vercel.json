{
  "framework": null,
  "installCommand": "if [ -d frontend ] && [ -d backend ]; then npm install && npm --prefix frontend install && npm --prefix backend install; else npm install && npm --prefix ../backend install; fi",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "conformix.vercel.app"
        }
      ],
      "destination": "https://integrax.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.conformix.vercel.app"
        }
      ],
      "destination": "https://integrax.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
