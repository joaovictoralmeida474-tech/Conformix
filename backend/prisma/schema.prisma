// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id         Int        @id @default(autoincrement())
  name       String
  users      User[]
  suppliers  Supplier[]
  categories Category[]
  alerts     Alert[]
}

model User {
  id          Int          @id @default(autoincrement())
  name        String       @default("Administrador")
  email       String       @unique
  password    String
  role        String       @default("ADMIN")
  active      Boolean      @default(true)
  companyId   Int
  authUserId  String?      @unique @db.Uuid
  company     Company      @relation(fields: [companyId], references: [id])
  auditLogs   AuditLog[]
  evaluations Evaluation[]
}

model Category {
  id          Int       @id @default(autoincrement())
  slug        String    @default("")
  name        String
  description String?
  active      Boolean   @default(true)
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  suppliers   Supplier[]
  questions   CategoryQuestion[]
  documents   CategoryRequiredDocument[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
}

model CategoryQuestion {
  id          Int        @id @default(autoincrement())
  categoryId  Int
  prompt      String
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  answers     EvaluationAnswer[]
}

model CategoryRequiredDocument {
  id               Int               @id @default(autoincrement())
  categoryId       Int
  name             String
  sortOrder        Int               @default(0)
  active           Boolean           @default(true)
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  supplierDocs     SupplierDocument[]
}

model Supplier {
  id                      Int                @id @default(autoincrement())
  name                    String
  tradeName               String?
  cnpj                    String
  contact                 String?
  email                   String?
  phone                   String?
  addressLine             String?
  addressNumber           String?
  addressComplement       String?
  district                String?
  city                    String?
  state                   String?
  postalCode              String?
  primaryActivity         String?
  registrationStatus      String?
  status                  String             @default("ATIVO")
  supplierType            String             @default("BASICO")
  score                   Float              @default(0)
  riskIndex               Float              @default(0)
  trend                   String             @default("ESTAVEL")
  reactivationJustification String?
  companyId               Int
  company                 Company            @relation(fields: [companyId], references: [id])
  categoryId              Int?
  category                Category?          @relation(fields: [categoryId], references: [id])
  lastEvaluationDate      DateTime?
  nextReview              DateTime?
  evaluations             Evaluation[]
  rncs                    RNC[]
  documents               SupplierDocument[]
  alerts                  Alert[]

  @@unique([companyId, cnpj])
}

model Evaluation {
  id             Int                @id @default(autoincrement())
  supplierId     Int
  evaluatorId    Int
  evaluationDate DateTime           @default(now())
  qualityScore   Int?
  deliveryScore  Int?
  priceScore     Int?
  serviceScore   Int?
  reliabilityScore Int?
  invoiceNumber  String?
  observations   String?
  answers        String?
  attachmentFilename     String?
  attachmentOriginalName String?
  score          Float
  classification String?
  createdAt      DateTime           @default(now())

  supplier       Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  evaluator      User               @relation(fields: [evaluatorId], references: [id])
  rnc            RNC?
  answerItems    EvaluationAnswer[]
}

model EvaluationAnswer {
  id                 Int               @id @default(autoincrement())
  evaluationId       Int
  categoryQuestionId Int?
  questionText       String
  score              Int
  sortOrder          Int               @default(0)
  evaluation         Evaluation        @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  categoryQuestion   CategoryQuestion? @relation(fields: [categoryQuestionId], references: [id], onDelete: SetNull)
}

model RNC {
  id               Int        @id @default(autoincrement())
  supplierId       Int
  evaluationId     Int?       @unique
  status           String     @default("ABERTA")
  actionPlan       String?
  description      String?
  cause            String?
  correctiveAction String?
  responsible      String?
  deadline         DateTime?
  treatedAt        DateTime?
  createdAt        DateTime   @default(now())

  supplier         Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  evaluation       Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
}

model SupplierDocument {
  id                 Int                       @id @default(autoincrement())
  supplierId         Int
  requiredDocumentId Int?
  documentName       String?
  filename           String?
  originalName       String?
  expiresAt          DateTime?
  supplier           Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  requiredDocument   CategoryRequiredDocument? @relation(fields: [requiredDocumentId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String   @default("sistema")
  entityId  Int?
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id            Int       @id @default(autoincrement())
  companyId     Int
  supplierId    Int?
  alertType     String
  message       String
  active        Boolean   @default(true)
  referenceDate DateTime  @default(now())
  createdAt     DateTime  @default(now())
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([supplierId, alertType, referenceDate])
}
